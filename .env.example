# Copy to .env.local for local dev. Set the same keys in the Vercel project
# (Settings -> Environment Variables) for Preview and Production.

# --- Mapbox (dark basemap under the map animations) ---
# Public token (pk....) for the Mapbox Static Images API. Client-visible by
# design; restrict it to your domains in the Mapbox account. If unset, the map
# scenes just render on the dark surface with no basemap.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Waitlist -> Google Sheet ---
# The site's only backend: each signup POSTs one row to a Google Apps Script
# web app bound to your sheet. Setup steps and the script are in
# docs/waitlist-sheet.gs.
#
# WAITLIST_SHEET_URL     deployed web-app URL, ends in /exec
# WAITLIST_SHEET_SECRET  long random string; must match SECRET in the script
WAITLIST_SHEET_URL=
WAITLIST_SHEET_SECRET=
